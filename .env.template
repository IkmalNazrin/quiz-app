# Environment variables template for QuizApp
# DO NOT commit real values to this file. Copy to `.env` for local development.

# Supabase Configuration
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Google OAuth Configuration
# The actual client secret should be retrieved from Google Cloud Console
# and placed in `client_secret_[client_id].apps.googleusercontent.com.json` locally.
# Never commit the JSON file.
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
